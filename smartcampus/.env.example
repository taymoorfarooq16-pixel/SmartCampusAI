# Copy this file to .env for local development. .env is ignored by Git.
# Replace the placeholders. Never commit real keys or passwords.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=true

# Leave empty to use local SQLite, or provide a PostgreSQL URL.
DATABASE_URL=

# Needed for Gemini-powered chat; leave blank to use FAQ-only fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
